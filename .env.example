# ==========================================
# BACKEND ENVIRONMENT VARIABLES (For Render)
# ==========================================
PORT=4000
NODE_ENV=production
POSTGRES_URL=postgresql://postgres:password@host:5432/valoriza
DATABASE_URL=postgresql://postgres:password@host:5432/valoriza
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,*
DB_POOL_MAX=10

# Primary Admin Account (Auto-created and linked on first database connection)
ADMIN_EMAIL=admin@valoriza.com
ADMIN_PASSWORD=ValorizaAdmin2025!

# Default Test User Account
USER_EMAIL=user@valoriza.com
USER_PASSWORD=ValorizaUser2025!

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (For Vercel)
# ==========================================
# Point to your deployed Render backend service
VITE_BACKEND_URL=https://your-backend.onrender.com
